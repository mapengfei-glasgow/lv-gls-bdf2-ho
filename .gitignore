.DS_Store
__pycache__/
*.pyc
*.zip
# heavy / noisy run outputs (monitor.csv, metadata.json, validation.json are tracked)
results/*/vtk/
results/*/log.txt
results/*/verify.txt
# generated refinement meshes (reproducible with convergence.command) and their VTK
mesh/lv_plain_h*/
results_convergence/*/vtk/
results_convergence/*/log.txt
results_convergence/*/verify.txt
# paper build products
paper/**/*.aux
paper/**/*.log
paper/**/*.fls
paper/**/*.fdb_latexmk
paper/**/figures/*.png
results_paper/*/vtk/
results_paper/*/log.txt
results_paper/*/verify.txt
# share archives
dist/
results_dalton/*/vtk/
results_dalton/*/log.txt
results_dalton/*/verify.txt
results_dalton/*/figures/*.png
# generated rule-based-fibre meshes
mesh/*_rb/
