.DS_Store
__pycache__/
*.pyc
*.zip
# VTK output anywhere (ParaView frames are regenerated by the run scripts)
*.vtu
*.pvtu
*.pvd
vtk/
# heavy / noisy run outputs (monitor.csv, metadata.json, validation.json are tracked)
results/*/vtk/
results/*/log.txt
results/*/verify.txt
# generated refinement meshes (reproducible with convergence.command) and their VTK
mesh/lv_plain_h*/
results_convergence/*/vtk/
results_convergence/*/log.txt
results_convergence/*/verify.txt
# paper build products
paper/**/*.aux
paper/**/*.log
paper/**/*.fls
paper/**/*.fdb_latexmk
paper/**/figures/*.png
results_paper/*/vtk/
results_paper/*/log.txt
results_paper/*/verify.txt
# share archives
dist/
results_dalton/*/vtk/
results_dalton/*/log.txt
results_dalton/*/verify.txt
results_dalton/*/figures/*.png
# generated rule-based-fibre meshes; downloaded Dalton geometries (only geom_0000 is tracked)
mesh/*_rb/
mesh/dalton_geom_*/
!mesh/dalton_geom_0000/
# surrogate data / checkpoints (regenerated by experiments/mean_base and geometry_narrow)
surrogate_data/
surrogate_runs/
data/dalton.hf-partial-2002
check/

surrogate_data.onegeom/
surrogate_data.smoke10/
surrogate_data.onecase/
surrogate_data.aha1000/
surrogate_data.aha200/

_work/
mean_geom/
data/dalton
mesh/aha_root/
surrogate_data*